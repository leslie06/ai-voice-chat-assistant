# systemd 服务单元：让 VCA 在服务器上常驻、开机自启、崩溃自动重启
# 安装：
#   1) 把 jar 放到 /opt/vca/vca.jar
#   2) 把真实 key 写进 /etc/vca.env（见下方 EnvironmentFile 示例）
#   3) sudo cp deploy/vca.service /etc/systemd/system/vca.service
#   4) sudo systemctl daemon-reload && sudo systemctl enable --now vca
#   5) 查看日志：journalctl -u vca -f

[Unit]
Description=VCA Voice Chat Assistant
After=network.target

[Service]
Type=simple
# 建议用专用非 root 用户运行
User=vca
WorkingDirectory=/opt/vca
EnvironmentFile=/etc/vca.env
# 2核4G 服务器：堆 1g，给 OS/Caddy/Netty直接内存 留余量。
# 内存只有 2G 时改回 -Xms256m -Xmx512m -XX:MaxDirectMemorySize=128m。
# 注意：并发通话每路都要占内存（下行节流缓冲最多 480KB/路 + VAD 状态），跑电话外呼时别用最小值。
ExecStart=/usr/bin/java -Xms512m -Xmx1g -XX:MaxDirectMemorySize=256m -Duser.timezone=Asia/Shanghai -jar /opt/vca/vca.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

# ---- /etc/vca.env 示例（自行创建，权限 600）----
# SPRING_PROFILES_ACTIVE=real
# SERVER_PORT=8080
# DASHSCOPE_API_KEY=sk-你的阿里云key
# DEEPSEEK_ENABLED=true
# DEEPSEEK_API_KEY=sk-你的deepseek-key
# DEEPSEEK_PROXY=
# VCA_STORE_ENABLED=true
# VCA_AUDIO_RECORDING_ENABLED=true
# VCA_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# VCA_OSS_BUCKET=你的私有Bucket
# VCA_OSS_ACCESS_KEY_ID=RAM用户AccessKeyId
# VCA_OSS_ACCESS_KEY_SECRET=RAM用户AccessKeySecret
# VCA_OSS_PREFIX=recordings
# VCA_MUSIC_OSS_ENABLED=true
# VCA_MUSIC_OSS_PREFIX=music
# VCA_MUSIC_OSS_URL_MINUTES=120
