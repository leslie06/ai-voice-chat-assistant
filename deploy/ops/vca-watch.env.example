# /etc/vca-watch.env —— 值守与备份脚本的配置(install.sh 首次安装时从这里拷一份, 权限 600)

# 告警推到哪个群: 企业微信或钉钉群机器人的地址。空 = 只写日志 /var/log/vca-ops.log, 不推送
# 建议单独建一个"运维"群, 别和商家的通话小结群混在一起
ALERT_WEBHOOK=

# 消息里怎么称呼这台机器。钉钉机器人设了"自定义关键词"的话, 把关键词写进来
SITE_NAME="fishai 电话客服"

# 只在这些钟点检查网关在不在线(诊所晚上断电关机就不必半夜报警); 空 = 全天
GW_CHECK_HOURS=8-21

# 通话录音保留多少天, 到期删除(录音里是客户的声音和手机号, 属于个人信息)。按和商家约定的来
RECORDING_KEEP_DAYS=90

# 其余一般不用改(括号里是默认值)
# FAIL_TIMES=2          VCA/FreeSWITCH 连续几次检查失败才报(每 5 分钟一次; 发布重启不会误报)
# GW_FAIL_TIMES=3       网关连续几次不在线才报
# DISK_LIMIT=85         磁盘占用百分比
# BACKUP_DIR=/var/backups/vca
# BACKUP_KEEP_DAYS=7
# VCA_ENV_FILE=/etc/vca.env
# FS_DIR=/opt/vca/freeswitch
# VCA_HEALTH_URL=http://127.0.0.1:8080/actuator/health
