<!--
  拨号计划。@VCA_HOST@/@VCA_PORT@ 由 entrypoint.sh 渲染。

  一通电话接进 VCA 的全过程:
    1. answer 应答
    2. socket 应用主动连 VCA(async full), VCA 在这条连接上拿到主叫/被叫/按键/挂机事件
    3. VCA 回一条 sendmsg unicast, FreeSWITCH 开一个 UDP 口把通话音频(L16 8k 裸 PCM)发给 VCA,
       同时把 VCA 发回来的 UDP 包写进通话 —— 这就是双向音频
  unicast 是 FreeSWITCH 内核自带的能力, 不需要 mod_audio_stream 之类的第三方模块。
-->
<section name="dialplan" description="Dialplan">
  <!--
    ai-inbound: 中继/语音网关打进来的电话落在这里(external profile 的 context)。
    只有一条规则: 不管被叫是哪个号码, 都交给 AI —— 号码本身会随通道数据交给 VCA,
    由它按 vca.telephony.merchants 认领是哪家商家。
  -->
  <context name="ai-inbound">
    <extension name="trunk-inbound">
      <condition field="destination_number" expression="^.*$">
        <action application="answer"/>
        <action application="execute_extension" data="vca-connect XML ai-agent"/>
      </condition>
    </extension>
  </context>

  <context name="ai-agent">

    <!-- 6000: 回声测试, 不经过 VCA。拨 AI 没声音时先拨它: 听得到自己 = 软电话↔FreeSWITCH 这段没问题 -->
    <extension name="echo">
      <condition field="destination_number" expression="^6000$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!--
      其余任何号码都接入 VCA。VCA 按接入号认领门店(开场白、资料、知识库、坐席、推送地址):
        语音网关的 LINE 分机在目录里绑了 vca_access_number, 以它为准(见 gateways/ 与 add-gateway.sh);
        没绑的(软电话、老的 ATA_LINE_USER)才用拨的号码。
      以前这里写死 500[01], 每开一家店都要改模板、重建容器。能打进来的只有认证过的分机,
      而拨号计划里没有任何通向外线的出口, 放开号码不会被盗打。
    -->
    <extension name="vca-inbound">
      <condition field="destination_number" expression="^[0-9]{3,20}$">
        <action application="answer"/>
        <action application="execute_extension" data="vca-connect XML ai-agent"/>
      </condition>
    </extension>

    <!--
      外呼接通后进这里: VCA 发 "originate {...}<号码> vca-outbound XML ai-agent",
      对端真正接听后通道才会进拨号计划, 所以不会对着彩铃说话。已接通, 不用再 answer。
    -->
    <extension name="vca-outbound">
      <condition field="destination_number" expression="^vca-outbound$">
        <action application="execute_extension" data="vca-connect XML ai-agent"/>
      </condition>
    </extension>

    <!-- 呼入与外呼共用的接入段 -->
    <extension name="vca-connect">
      <condition field="destination_number" expression="^vca-connect$">
        <!--
          告诉 VCA 媒体该怎么走(VCA 从 socket 连接的通道变量里读):
            vca_media_local_ip    FreeSWITCH 这一侧 UDP 口绑哪个地址。容器里必须 0.0.0.0 ——
                                  绑 127.0.0.1 的套接字发不出容器;
                                  FreeSWITCH 与 VCA 同机部署(非容器)时应改回 127.0.0.1, 免得别人往通话里灌音频
            vca_media_remote_host FreeSWITCH 眼里 VCA 的地址
        -->
        <action application="set" data="vca_media_local_ip=@VCA_MEDIA_BIND@"/>
        <action application="set" data="vca_media_remote_host=@VCA_HOST@"/>
        <!-- VCA 挂了或没回挂机指令时的兜底: 停泊超过 15 分钟自动挂断, 不留僵尸通道 -->
        <action application="set" data="park_timeout=900"/>
        <!--
          双声道录音: 左 = 来电方说的, 右 = VCA 回的。文件名就是通话 id, 与 VCA 日志和落库记录对得上。
          商家后台可回放; 超过保留期由 deploy/ops/vca-cleanup.sh 删除(录音是个人信息, 留存要有上限)
        -->
        <action application="set" data="RECORD_STEREO=true"/>
        <action application="record_session" data="/recordings/${uuid}.wav"/>
        <action application="socket" data="@VCA_HOST@:@VCA_PORT@ async full"/>
        <!--
          走到这里说明 VCA 没接住这通电话: 连不上(没起、正在重启发布、崩了)、握手失败、或通话中途连接断了。
          正常结束的通话走不到这里 —— 那时通道已经挂断, 拨号计划不再往下执行。
          有兜底座机的(网关的 LINE 分机绑了 vca_fallback_dial)就转过去, 让前台接; 没有才挂断。
        -->
        <action application="execute_extension" data="vca-fallback XML ai-agent"/>
        <action application="hangup"/>
      </condition>
    </extension>

    <!-- AI 接不了时转前台座机。条件是分机目录里配了 vca_fallback_dial(add-gateway.sh 会配成这家店的 PHONE 分机) -->
    <extension name="vca-fallback">
      <condition field="destination_number" expression="^vca-fallback$"/>
      <condition field="${vca_fallback_dial}" expression="^user/[0-9A-Za-z_.-]+@[0-9A-Za-z_.-]+$">
        <action application="log" data="WARNING VCA 没接住这通电话, 转前台 ${vca_fallback_dial}"/>
        <!-- 等前台接的这段放国内回铃音(响 1 秒停 4 秒), 别让客户以为断线了 -->
        <action application="set" data="ringback=%(1000,4000,450)"/>
        <action application="set" data="call_timeout=40"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="bridge" data="${vca_fallback_dial}"/>
      </condition>
    </extension>

  </context>
</section>
