<!-- 分机目录。@SIP_PASSWORD@ 由 entrypoint.sh 渲染。 -->
<section name="directory" description="Users">
  <domain name="$${domain}">
    <params>
      <!--
        originate user/1000 时怎么找到这个分机: 查它当前的注册地址。
        精简配置里漏了这一行, 外呼就会报 "No dial-string available" / MANDATORY_IE_MISSING。
      -->
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(*/${dialed_user}@${dialed_domain})}"/>
    </params>
    <!-- 软电话(本地联调) -->
    <user id="1000">
      <params>
        <param name="password" value="@SIP_PASSWORD@"/>
      </params>
      <variables>
        <variable name="user_context" value="ai-agent"/>
        <variable name="effective_caller_id_number" value="1000"/>
        <!-- 外呼测试(originate user/1000)要把 INVITE 发回软电话: 按注册包的实际来源地址发, 不信它自报的 Contact -->
        <variable name="sip-force-contact" value="NDLB-connectile-dysfunction"/>
      </variables>
    </user>

    <!--
      语音网关(如 Grandstream HT813)的两个口, 由 entrypoint.sh 按 ATA_* 渲染; 没配就没有这两个分机。

        LINE 口(FXO) —— 接电话线。有人打进来时它自动接起, 把这通电话以 SIP 发给 FreeSWITCH。
        PHONE 口(FXS) —— 接有绳电话机。转人工时 FreeSWITCH 把通话桥接过来, 话机就响。

      两个口各注册一个分机: 网关在诊所路由器后面, 家用宽带是动态 IP, 按 IP 放行行不通, 只能靠注册。
    -->
@ATA_USERS@
  </domain>
</section>
