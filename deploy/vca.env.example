# ============================================================================
# /etc/vca.env 模板
#
# 用法: cp deploy/vca.env.example /etc/vca.env && chmod 600 /etc/vca.env
#       填入真实密钥后 systemctl restart vca
#
# 这里的环境变量优先级高于 application.yml，改完只需重启、不用重新打包。
# 凡是标 <填写> 的都是密钥，务必别提交回仓库。
#
# 只列常用项；完整配置项以 vca-bootstrap/src/main/resources/application.yml 为准。
# ============================================================================

# ---- 基础 ----
SPRING_PROFILES_ACTIVE=real
SERVER_PORT=8080
# 生产必设 INFO。DEBUG 下每轮对话打大量细节，长期累积能把磁盘写满，
# 而磁盘一满会以各种看似无关的形式炸出来（数据库起不来、查询挂起），极难定位。
VCA_LOG_LEVEL=INFO

# ---- 大模型 ----
DASHSCOPE_API_KEY=<填写>              # 阿里云；ASR/TTS/S2S/向量化共用
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=<填写>
DEEPSEEK_PROXY=                        # 服务器上必须留空；本机开了 Clash 才需要填
VCA_LLM_VENDOR=deepseek                # deepseek / qwen / moonshot
KIMI_ENABLED=false
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---- 工具（留空即不注册该工具）----
AMAP_API_KEY=                          # 高德，天气查询
BOCHA_API_KEY=                         # 博查，联网搜索

# ---- 落库与账号 ----
VCA_STORE_ENABLED=true
VCA_STORE_URL=jdbc:mysql://127.0.0.1:3306/vca?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
VCA_STORE_USERNAME=<填写>
VCA_STORE_PASSWORD=<填写>
# 登录令牌签名密钥。★ 必须设一个固定随机串: openssl rand -hex 32
#   - 留空会回落到 application.yml 里的默认值，而那个值在仓库里是公开的，
#     任何人都能据此伪造任意用户的登录令牌。
#   - 改动它会让所有已登录用户当场失效（令牌本身不带过期时间），所以设好就别再动。
VCA_STORE_TOKEN_SECRET=<填写>
VCA_STORE_EMBEDDING_ENABLED=true       # 向量记忆 + RAG，复用 DASHSCOPE_API_KEY
# 连接池：这个池不只服务后台落库，账号鉴权、会话历史、记忆、RAG、音乐目录都用它。
# 太小会在几个用户同时聊天时打满，而报错出现在登录等看似无关的地方。
VCA_STORE_MAX_POOL_SIZE=16
VCA_STORE_LEAK_DETECTION_MS=20000      # 连接借出超时未还即打印调用栈，排查泄漏
VCA_STORE_LOCK_WAIT_TIMEOUT_SECONDS=15 # MySQL 默认 365 天，会让启动 DDL 无声挂死

# ---- 找回密码邮件（不配 mail-host 就不发信）----
VCA_STORE_BASE_URL=
VCA_STORE_MAIL_HOST=
VCA_STORE_MAIL_PORT=465
VCA_STORE_MAIL_USERNAME=
VCA_STORE_MAIL_PASSWORD=<填写>          # 邮箱的 SMTP 授权码，不是登录密码
VCA_STORE_MAIL_FROM=
VCA_STORE_MAIL_SSL=true
VCA_STORE_MAIL_STARTTLS=false

# ---- OSS 录音 ----
VCA_AUDIO_RECORDING_ENABLED=false
VCA_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
VCA_OSS_BUCKET=
VCA_OSS_ACCESS_KEY_ID=<填写>
VCA_OSS_ACCESS_KEY_SECRET=<填写>
VCA_OSS_PREFIX=recordings

# ---- 音乐（OSS 私有曲库；endpoint 必须是手机能访问的公网地址）----
VCA_MUSIC_OSS_ENABLED=false
VCA_MUSIC_OSS_ENDPOINT=
VCA_MUSIC_OSS_BUCKET=
VCA_MUSIC_OSS_ACCESS_KEY_ID=<填写>
VCA_MUSIC_OSS_ACCESS_KEY_SECRET=<填写>
VCA_MUSIC_OSS_PREFIX=music
VCA_MUSIC_OSS_URL_MINUTES=120

# ---- 并发与时长 ----
# 都不是"自动"能定的：治理层会自动做厂商配额/熔断/故障转移，但它不知道你的预算，
# 也不知道你能容忍多少延迟。下面两个是最外层的闸。
#   带宽估算: 下行 TTS 是 24kHz/16bit 裸 PCM ≈ 384 kbps/路。
#   注意每路对话都在烧 ASR+LLM+TTS 三份按量付费，真正的成本闸门是账号系统而非并发数。
VCA_MAX_CONNECTIONS=20
VCA_MAX_SESSION_SECONDS=900            # 防有人开着标签页去吃饭，白占名额还在跑 VAD

# ---- VAD / 语音打断（★ 最容易调错的一组）----
VCA_VAD_HALF_DUPLEX=false              # false=全双工，可以语音打断；true=只能点按钮打断
# 打断阈值。★ 别凭感觉往上调 —— 调到接近你说话的音量时打断会彻底失效:
#   判定逻辑是"过阈值累加、低于阈值回扣"，人声本就起伏，
#   阈值一旦顶到说话峰值，累计值永远攒不够 barge-ms，表现就是"完全打不断"。
# 定值方法: 开着日志说几句话，看 HandsFreeVad 打的
#     "开口诊断(AWAIT): 近2s峰值人声=X"   → X 就是你说话的音量
#     安静时同一行的 X                     → 环境噪声
#   取两者之间、靠近噪声那一侧。
# 一次真机实测(浏览器 + 笔记本麦克风): 噪声 0.0001~0.004，说话 0.33~0.42 → 取 0.12 最合适。
# 前端已开浏览器回声消除，外放没那么容易自打断；真被回声打断优先调大 grace 而不是抬阈值。
VCA_VAD_BARGE_THRESHOLD=0.12
VCA_VAD_BARGE_MS=300                   # 人声需持续这么久才算插话
VCA_VAD_BARGE_GRACE_MS=300             # 机器人开口后这段时间内不判打断，挡自己头几个字的回声

# ---- 电话接入（外呼/呼入，默认关）----
# 联调步骤见 docs/10-telephony-outbound.md
VCA_TELEPHONY_ENABLED=false
VCA_TELEPHONY_PORT=9092                # AudioSocket 监听端口，Asterisk 连过来
VCA_TELEPHONY_GREETING=                # 开场白文本，启动时预合成，接通瞬间出声
VCA_TELEPHONY_TTS_VOICE=               # 留空 = 用 gateway 候选的音色（别写死，写死会 418）
VCA_TELEPHONY_SWAP_BYTES=false         # 联调时听到刺耳噪声而非人声就设 true
VCA_TELEPHONY_API_TOKEN=               # 留空 = 不注册外呼端点；这个接口会真的打电话花钱
# AMI：外呼所需，不开只能接呼入
VCA_AMI_ENABLED=false
VCA_AMI_HOST=127.0.0.1
VCA_AMI_PORT=5038
VCA_AMI_USERNAME=<填写>
VCA_AMI_SECRET=<填写>
VCA_AMI_TRUNK=trunk                    # SIP 中继名，拨号串 = PJSIP/<号码>@<trunk>
VCA_AMI_CONTEXT=ai-agent
