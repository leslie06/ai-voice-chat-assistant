# 复制为 .env 并填入真实值: `cp .env.example .env`
# .env 已被 .gitignore 忽略, 不会提交。run.sh 启动时自动加载。

# DeepSeek (LLM) —— 必填
DEEPSEEK_API_KEY=

# 阿里云 DashScope (ASR / TTS) —— 必填
DASHSCOPE_API_KEY=

# Kimi K3 (LLM) —— 可选。启用后可在页面选择 Kimi K3。
# Key 只放本地/服务器环境文件，不要写入 application.yml 或提交 Git。
KIMI_ENABLED=false
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# OSS 私有音乐曲库 —— 可选。若已配置录音 OSS，endpoint/bucket/AK 可自动复用 VCA_OSS_*。
VCA_MUSIC_OSS_ENABLED=false
# 未配置录音 OSS 或音乐使用不同 Bucket 时，取消下面注释并填写：
# VCA_MUSIC_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# VCA_MUSIC_OSS_BUCKET=
# VCA_MUSIC_OSS_ACCESS_KEY_ID=
# VCA_MUSIC_OSS_ACCESS_KEY_SECRET=
VCA_MUSIC_OSS_PREFIX=music
VCA_MUSIC_OSS_URL_MINUTES=120

# 说明：用户上传歌曲入口已下线，阿里云内容审核（VCA_MUSIC_MODERATION_*）随之移除。
# 原因是审核队列每 15 秒重扫一次待审记录，提交失败的记录会无限重试并反复产生按次计费的文本审核调用。

# 高德开放平台 Web 服务 key —— 查天气工具(get_weather)用; 留空则不启用该工具。
# 申请: https://console.amap.com → 应用管理 → Key(类型选"Web服务")。
AMAP_API_KEY=

# WebSocket 共享访问令牌: 留空=不校验(本地开发)。公网部署务必设一个够长的随机串。
VCA_AUTH_TOKEN=

# 可选: DeepSeek 走代理(本机开了 Clash 等再设); 置空=直连。
# DEEPSEEK_PROXY=http://127.0.0.1:7890
