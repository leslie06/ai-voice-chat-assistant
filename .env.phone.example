# 电话客服模式的本机参数。用法: cp .env.phone.example .env.phone 再按需改。
# 完整默认值见 start-phone.sh; 这里只列最常改的几项。.env.phone 不进仓库。

# 接通后先说的话。启动时预合成, 所以接通瞬间就出声。
VCA_TELEPHONY_GREETING=您好，这里是智能语音助手，请问有什么可以帮您的吗？

# 按谁的知识库作答: 商家账号 id(app_user.id)。
# 商家用这个账号登录网页, 把项目/价格/营业时间传进 POST /api/knowledge, 电话里就能据此作答。
# 留空 = 电话里没有知识库, 商家资料类问题答不了。
VCA_TELEPHONY_KNOWLEDGE_OWNER=

# 转人工桥接到哪(媒体服务器的拨号串)。
# 接中继: sofia/gateway/trunk/<商家手机>; 本地联调拨软电话: user/1000。
# 留空 = 不下发转人工工具(AI 会改说"让同事回电给您")。
VCA_TELEPHONY_TRANSFER_DIAL_STRING=

# 对话模型。电话要的是首字快 —— 带思考链的模型会先想一段才开口。
VCA_TELEPHONY_LLM_MODEL=qwen-flash

# 说话判定。这三项是按软电话(麦克风电平偏低)调的; 接真实电话线路时建议整行删掉, 用代码默认值。
VCA_TELEPHONY_VAD_SPEECH=0.01
VCA_TELEPHONY_VAD_ONSETMS=100
VCA_TELEPHONY_VAD_BARGE=0.015

# 通话后小结推给谁: 企业微信/钉钉群机器人的 webhook URL。留空 = 只落库(phone_call_summary), 不推送。
VCA_TELEPHONY_SUMMARY_WEBHOOK=

# ---- 多商家(可选): 按客户拨的号码区分。不配就是单店, 全部走上面那套默认配置 ----
# 每家只写要改的项, 没填的回退到默认。
#VCA_TELEPHONY_MERCHANTS_0_NUMBER=01088886666
#VCA_TELEPHONY_MERCHANTS_0_NAME=美好口腔
#VCA_TELEPHONY_MERCHANTS_0_GREETING=您好，这里是美好口腔，请问有什么可以帮您的吗？
#VCA_TELEPHONY_MERCHANTS_0_KNOWLEDGE_OWNER=11
#VCA_TELEPHONY_MERCHANTS_0_TRANSFER_DIAL_STRING=sofia/gateway/trunk/13800138000
#VCA_TELEPHONY_MERCHANTS_0_SUMMARY_WEBHOOK=
#VCA_TELEPHONY_MERCHANTS_1_NUMBER=01099998888
#VCA_TELEPHONY_MERCHANTS_1_NAME=启明少儿英语
#VCA_TELEPHONY_MERCHANTS_1_KNOWLEDGE_OWNER=12
